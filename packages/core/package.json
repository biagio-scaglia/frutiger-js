{
  "name": "@frutiger.js/core",
  "version": "1.12.0",
  "description": "Pure CSS design system inspired by Frutiger Aero and Web 2.0 aesthetics.",
  "type": "module",
  "main": "./dist/styles.css",
  "style": "./dist/styles.css",
  "homepage": "https://biagio-scaglia.github.io/frutiger-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/frutiger-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/frutiger-js/issues"
  },
  "sideEffects": [
    "dist/*.css",
    "src/**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": "./dist/styles.css",
    "./reset": "./src/reset.css",
    "./tokens": "./src/tokens/index.css",
    "./components": "./src/components/index.css",
    "./utilities": "./src/utilities/utilities.css",
    "./themes/*": "./src/themes/*.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "node -e \"console.log('@frutiger-js/core is CSS-first; no TS check required.')\""
  },
  "keywords": [
    "frutiger-aero",
    "css",
    "design-system",
    "ui-library",
    "web2",
    "skeuomorphism",
    "glassmorphism",
    "tokens",
    "aero-glass",
    "modern-css"
  ],
  "author": "Biagio Scaglia <biagio.scaglia@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
