{
  "name": "frutiger-js-monorepo",
  "version": "1.0.3",
  "private": true,
  "description": "Frutiger Aero, rebuilt for the modern web. React component library & CSS design system.",
  "type": "module",
  "homepage": "https://biagio-scaglia.github.io/frutiger-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/frutiger-js.git"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/frutiger-js/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@frutiger.js/playground",
    "build": "npm run build --workspace=@frutiger.js/core && npm run build --workspace=@frutiger.js/react && npm run build --workspace=@frutiger.js/playground",
    "build:packages": "npm run build --workspace=@frutiger.js/core && npm run build --workspace=@frutiger.js/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=@frutiger.js/core && npm run typecheck --workspace=@frutiger.js/react && npm run typecheck --workspace=@frutiger.js/playground",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "bump": "node scripts/release.mjs",
    "bump:minor": "node scripts/release.mjs minor",
    "bump:major": "node scripts/release.mjs major",
    "publish:npm": "npm publish ./packages/core --access public && npm publish ./packages/react --access public",
    "release": "node scripts/release.mjs --publish",
    "release:minor": "node scripts/release.mjs minor --publish"
  },
  "keywords": [
    "react",
    "react-components",
    "ui",
    "design-system",
    "css",
    "frutiger-aero",
    "frutiger",
    "web2",
    "web-design",
    "component-library",
    "typescript"
  ],
  "author": "Biagio Scaglia <biagio.scaglia@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  }
}
